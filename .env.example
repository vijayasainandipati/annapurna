# Copy to .env for Docker Compose / production deployment
APP_ENV=development

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_local_db_password
POSTGRES_DB=annapurna
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=change_this_local_db_password
DB_NAME=annapurna

# Generate a strong secret before production deployment:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_generated_random_secret_key

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Frontend: set to true ONLY in local development/demo environments
NEXT_PUBLIC_DEMO_MODE=false
